 103          // Function to calculate RPM from edge count
 104          unsigned int calculate_RPM() {
 105   1          unsigned int RPM = 0;
 106   1          unsigned int edges = edge_count;    // Copy edge count to avoid ISR interference
 107   1          edge_count = 0;                     // Reset edge count for the next cycle
 108   1      
 109   1          // Calculate RPM (assuming 2 edges per revolution)
 110   1          RPM = (edges * 60000) / (PWM_period * 2); // RPM = (edges * 60 s) / (period * 2 edges/rev)
 111   1          return RPM;
 112   1      }
