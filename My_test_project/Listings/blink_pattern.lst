   4          /* LED patterns display
   5          There are many patterns to take reference from:
   6          1. Chaser pattern: One blink at a time, increment and 
   7          in a loop
   8          
   9          2. Bllinking pattern: Light up all the same time and
  10          dim down all the same time
  11          
  12          3. ALternating pattern: Light up every second LED
  13          and vice versa
  14          
  15          4. Knight rider pattern: Light up in sequence and go
  16          back and forth, in medium pace
  17          
  18          5. Wave pattern: Light up in sequence, back and forth,
  19          fast pace
  20          
  21          6. Ping pong pattern: Light up the far_end pair inward
  22          to the center, and outward again
  23          
  24          Instruction:
  25          - Set 8 LEDs to port 1 for display
  26          */
  27          
  28          /*
  29          1. Timer Delay Calculation
  30          With a 10 MHz clock:
  31          
  32          Machine cycle time = 12 / 10 MHz = 1.2 탎
  33          Each timer tick takes 1.2 탎.
  34          The 8051's Timer 0 can be set in 16_bit mode (Mode 1), 
  35          which allows counts from 0x0000 to 0xFFFF (65536 ticks).
  36          
  37          2. Calculating Timer Reload Values
  38          Using these values, we can calculate the timer reload 
  39          value required to create each delay:
  40          
  41          50 ms delay: 
  42                  50,000탎/1.2탎 = 41667 ticks
  43          100 ms delay: 
  44                  100,000탎/1.2탎 = 83333 ticks
  45          200 ms delay: 
  46                  200,000탎/1.2탎 = 166667 ticks
  47          500 ms delay: 
  48                  500,000탎/1.2탎 = 416667 ticks
  49                  
  50          Since the 16_bit timer can count only up to 65536, 
  51          loops have to be used within the delay function to 
  52          achieve these longer delays.
  53          */
  54          void Timer0_Delay(unsigned int delay_ms) {
C51 COMPILER V9.60.7.0   BLINK_PATTERN                                                     11/10/2024 11:06:36 PAGE 2   

  55   1          unsigned char i;  // Loop counter
  56   1          unsigned int reload_count;
  57   1      
  58   1          switch (delay_ms) {
  59   2              case 50:
  60   2                  reload_count = 1;  // Approximately 50 ms with 1 iteration
  61   2                  TH0 = 0x3C;        // Load Timer0 high byte for 50 ms
  62   2                  TL0 = 0xB0;        // Load Timer0 low byte for 50 ms
  63   2                  break;
  64   2              case 100:
  65   2                  reload_count = 2;  // Approximately 100 ms with 2 iterations of 50 ms
  66   2                  TH0 = 0x3C;
  67   2                  TL0 = 0xB0;
  68   2                  break;
  69   2              case 200:
  70   2                  reload_count = 4;  // Approximately 200 ms with 4 iterations of 50 ms
  71   2                  TH0 = 0x3C;
  72   2                  TL0 = 0xB0;
  73   2                  break;
  74   2              default: // Default to 500 ms
  75   2                  reload_count = 10;  // Approximately 500 ms with 10 iterations of 50 ms
  76   2                  TH0 = 0x3C;
  77   2                  TL0 = 0xB0;
  78   2          }
  79   1      
  80   1          TMOD = 0x01; // Set Timer0 to 16-bit mode (Mode 1)
  81   1      
  82   1          for (i = 0; i < reload_count; i++) {
  83   2              TR0 = 1;         // Start Timer0
  84   2              while (TF0 == 0); // Wait for overflow
  85   2              TR0 = 0;         // Stop Timer0
  86   2              TF0 = 0;         // Clear overflow flag
  87   2          }
  88   1      }
