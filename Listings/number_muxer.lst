  64          void Delay500ms(){
  65   1          // Generate a 0.5 second delay for a 10 MHz clock using Timer 0 in 16-bit mode
  66   1          unsigned char i;
  67   1          for (i = 0; i < 40; i++){   // Loop to generate approximately 0.5 seconds
  68   2              // Timer 0 delay calculation for 12-clock cycle 8051 with a 10 MHz clock:
  69   2              // 1 machine cycle = 12 / 10 MHz = 1.2 us
  70   2              // Max timer count = 65536, thus the timer max duration = 65536 * 1.2 us = 78.432 ms
  71   2              // Divide 0.5 seconds by 78.432 ms to get around 6.375 cycles, rounding up to 7
  72   2                      TMOD = 0x01;            // Timer0 mode 1 (16-bit timer)
  73   2                      TH0 = 0x3C;             // Load high byte for 50 ms delay
  74   2                      TL0 = 0xB0;                 // Load low byte for 50 ms delay
  75   2              TR0 = 1;            // Start Timer0
  76   2              while (TF0 == 0);   // Wait for Timer0 overflow flag
  77   2              TR0 = 0;                // Stop Timer0
  78   2              TF0 = 0;                // Clear overflow flag
  79   2          }
  80   1      }
