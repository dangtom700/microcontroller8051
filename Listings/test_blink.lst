   8          void Delay500ms(){
   9   1          // Generate a 0.5 second delay for a 10 MHz clock using Timer 0 in 16-bit mode
  10   1          unsigned int i;
  11   1          for (i = 0; i < 40; i++){   // Loop to generate approximately 0.5 seconds
  12   2              // Timer 0 delay calculation for 12-clock cycle 8051 with a 10 MHz clock:
  13   2              // 1 machine cycle = 12 / 10 MHz = 1.2 us
  14   2              // Max timer count = 65536, thus the timer max duration = 65536 * 1.2 us = 78.432 ms
  15   2              // Divide 0.5 seconds by 78.432 ms to get around 6.375 cycles, rounding up to 7
  16   2              TMOD = 0x01;   // Timer0 mode 1 (16-bit timer)
  17   2              TH0 = 0x3C;    // Load high byte for 50 ms delay
  18   2              TL0 = 0xB0;    // Load low byte for 50 ms delay
  19   2              TR0 = 1;       // Start Timer0
  20   2              while (TF0 == 0);  // Wait for Timer0 overflow flag
  21   2              TR0 = 0;       // Stop Timer0
  22   2              TF0 = 0;       // Clear overflow flag
  23   2          }
  24   1      }
